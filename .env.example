# ==============================================================================
# MCU Exam Portal - Environment Configuration Template
# วิทยาลัยสงฆ์พ่อขุนผาเมือง มหาวิทยาลัยมหาจุฬาลงกรณราชวิทยาลัย
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=production

# Security & Encryption Secrets (Change these in production to random strings of 32+ characters)
SESSION_SECRET=mcu_exam_session_secret_replace_in_production_key_2026
CSRF_SECRET=mcu_exam_csrf_secret_replace_in_production_key_2026

# Google Identity Services / OAuth 2.0
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# University Private Google Drive Storage
# Storage mode: 'drive' for production Google Drive, 'local' for dev/testing isolated storage
STORAGE_MODE=drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-private-google-drive-folder-id

# Google Service Account Credentials (For server-side Private Drive file manipulation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=mcu-exam-storage-sa@your-gcp-project.iam.gserviceaccount.com
# Can be a JSON file path or raw JSON string
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json

# Development Options (STRICTLY FALSE in production)
ALLOW_DEV_LOGIN=false
